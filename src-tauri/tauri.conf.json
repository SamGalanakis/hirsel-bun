{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hirsel",
  "version": "0.1.0",
  "identifier": "app.hirsel",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run build:css",
    "beforeBuildCommand": "npm run build:css && npm run build:ts"
  },
  "app": {
    "windows": [
      {
        "title": "Hirsel",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
