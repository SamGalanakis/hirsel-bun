# Dockerfile.coordinator - Hirsel coordinator for Fly.io
#
# Build:
#   cd src-tauri && cargo build --release --no-default-features --features cli,s3-storage
#   fly deploy

FROM ubuntu:24.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    git \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-built binary
COPY src-tauri/target/release/hirsel /usr/local/bin/hirsel

# Create data directory
RUN mkdir -p /data

# Expose the coordinator port
EXPOSE 3000

# Run hirsel server
ENTRYPOINT ["hirsel", "serve", "--port", "3000"]
