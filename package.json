{
  "name": "hirsel",
  "version": "0.1.0",
  "description": "Herd your AI coding agents",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --features gui",
    "build": "vite build && tauri build --features gui",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "tauri": "tauri",
    "lint": "biome check src/",
