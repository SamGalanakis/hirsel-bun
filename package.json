    "test": "cargo nextest run --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "typescript": "^5",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.5.3"
  }
}
